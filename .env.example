# Copy to .env.local and fill in. Never commit real credentials.
#
# Local MySQL / XAMPP:
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/hrmd_kiosk"
#
# Hosted MySQL (needs TLS):
# DATABASE_URL="mysql://user:password@db.example.com:3306/hrmd_kiosk?ssl=true"

# Required for signing HRMD admin sessions. Generate a unique random value.
SESSION_SECRET="replace-with-a-long-random-value"
